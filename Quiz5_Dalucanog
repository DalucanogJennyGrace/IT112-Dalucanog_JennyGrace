#include <stdio.h>

int main() {
    float savings, total = 0, average, goal = 500.00;
    int day;
    
    printf("===================================\n");
    printf("       DAILY SAVINGS TRACKER\n");
    printf("===================================\n");
    
    for(day = 1; day <= 7; day++) {
      printf("Enter savings for Day %d: ", day);
      scanf("%f", &savings);
      total += savings;
 }
 

average = total / 7;

printf("\n===================================\n");
printf("          SAVINGS SUMMARY\n");
printf("===================================\n");
printf("Total Savings: PHP %.2f\n", total);
printf("Daily Average: PHP %.2f\n", average);

if(total >= goal) {
   printf("Status: GOAL REACHED\n");
    printf("Congratulations! You met your weekly savings goal.\n");
    } else {
      float shortfall = goal - total;
      printf("Status: GOAL NOT REACHED\n");
      printf("You need PHP %.2f more to reach your goal.\n", shortfall);
 }
printf("===================================\n"); 
    return 0;
}