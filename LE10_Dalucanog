#include <stdio.h>
#include <stdlib.h>

int main() {
    FILE *file;
    char note[200];
    int numNotes;
    int i;

    file = fopen("notes.txt", "w");

    if (file == NULL) {
        printf("Error creating file!\n");
        return 1;
    }

    printf("Writing Notes File:\n");
    printf("How many notes do you want to record? ");
    scanf("%d", &numNotes);
    getchar();

    for (i = 1; i <= numNotes; i++) {
        printf("\nNote %d: ", i);
        fgets(note, sizeof(note), stdin);
        fputs(note, file);
    }

    fclose(file);

    printf("\nInitial notes saved successfully.\n");

    file = fopen("notes.txt", "a");

    if (file == NULL) {
        printf("Error opening file!\n");
        return 1;
    }

    printf("\nEnter one additional note:\n");
    fgets(note, sizeof(note), stdin);
    fputs(note, file);

    fclose(file);

    printf("\nNew note added successfully.\n");

    file = fopen("notes.txt", "r");

    if (file == NULL) {
        printf("Error reading file!\n");
        return 1;
    }

    printf("\nReading Saved Notes:\n");

    i = 1;
    while (fgets(note, sizeof(note), file) != NULL) {
        printf("%d. %s", i, note);
        i++;
    }

    fclose(file);

    return 0;
}